{
  "name": "@kakeibo/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@kakeibo/shared": "workspace:*",
    "better-auth": "^1.5.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4",
    "postgres": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
